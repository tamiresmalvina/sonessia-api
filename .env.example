# AMBIENTE
NODE_ENV=development
PORT=<PORTA_DA_API>

# FRONTEND (ainda não implementado)
FRONTEND_ORIGIN=<ORIGEM_DO_FRONTEND>

# BANCO DE DADOS
DATABASE_URL=<URL_DE_CONEXAO_POSTGRESQL>

# JWT
JWT_ACCESS_SECRET=<SEGREDO_ALEATORIO_FORTE>
JWT_ISSUER=<EMISSOR_DO_TOKEN>
JWT_AUDIENCE=<PUBLICO_DO_TOKEN>
ACCESS_TOKEN_TTL=<DURACAO_DO_TOKEN_DE_ACESSO>

# ATUALIZACAO DE TOKENS
REFRESH_TOKEN_TTL_DAYS=<DIAS_ATE_EXPIRACAO>

# E-MAIL
EMAIL_PROVIDER=<PROVEDOR_DE_EMAIL>