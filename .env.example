# AMBIENTE
# Set NODE_ENV explicitly; use production in Render.
NODE_ENV=development
PORT=3000
# Use direct locally. On a public Render Web Service, set render to use its
# Cloudflare-provided CF-Connecting-IP header for client identification.
# Express still does not trust X-Forwarded-For or enable trust proxy=true.
TRUST_PROXY_MODE=direct

# Local frontend. In production, use the exact HTTPS origin without a path or trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# DATABASE
DATABASE_URL=<POSTGRESQL_CONNECTION_URL>

# JWT
# In production, generate at least 32 random bytes with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never reuse a development secret or publish the generated value.
JWT_ACCESS_SECRET=LOCAL_DEVELOPMENT_ONLY_SECRET
JWT_ISSUER=sonessia-api
JWT_AUDIENCE=sonessia-web
# Integer with unit s, m, h, or d; accepted range is 1m to 1h.
ACCESS_TOKEN_TTL=15m

# REFRESH TOKEN
# Integer from 1 to 90 days.
REFRESH_TOKEN_TTL_DAYS=7

# Configuração de e-mail
EMAIL_PROVIDER=ethereal

# Mailpit (desenvolvimento)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Remetente
EMAIL_FROM=

# Gmail SMTP (utilizar somente quando EMAIL_PROVIDER=gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limits use in-memory stores. Keep one API instance until a shared store
# is introduced; multiple instances do not share counters.
