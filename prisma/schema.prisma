generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  COMUM
  ADMIN
}

enum StatusSessao {
  ATIVA
  ROTACIONADA
  ENCERRADA
  REVOGADA
}

enum Finalidade {
  ESTUDO
  RELAXAMENTO
  SONO
  MEDITACAO
  CONCENTRACAO
  TRABALHO
}

enum TipoCategoria {
  AUDIO
  AMBIENTE
}

model Categoria {
  idCategoria     String        @id @default(uuid()) @db.Uuid
  nome            String
  tipo            TipoCategoria
  ativa           Boolean       @default(true)
  dataCriacao     DateTime      @default(now())
  dataAtualizacao DateTime      @updatedAt

  audios           Audio[]
  ambientesSonoros AmbienteSonoro[]

  @@unique([nome, tipo])
  @@index([tipo, ativa])
}

model Usuario {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  email              String    @unique
  senha              String
  dataNascimento     DateTime
  fotoPerfil         String?
  fotoPerfilPublicId String?
  perfil             Perfil    @default(COMUM)
  emailVerificado    Boolean   @default(false)
  senhaAlteradaEm    DateTime?
  versaoToken        Int       @default(1)
  exclusaoSolicitadaEm         DateTime?
  exclusaoDefinitivaEm         DateTime?
  exclusaoProcessamentoAte     DateTime?
  exclusaoProcessamentoToken   String?   @db.Uuid

  colecoes               Colecao[]
  ambientesSonoros       AmbienteSonoro[]
  audios                 Audio[]
  codigosVerificacao     CodigoVerificacaoEmail[]
  sessoes                Sessao[]
  tokensRecuperacaoSenha TokenRecuperacaoSenha[]
  alteracoesEmail        AlteracaoEmail[]

  @@index([exclusaoDefinitivaEm])
}

model AlteracaoEmail {
  id                     String    @id @default(uuid()) @db.Uuid
  idUsuario              String    @db.Uuid
  emailAtual             String
  emailNovo              String
  tokenEmailAtualHash    String?   @unique
  tokenEmailNovoHash     String?   @unique
  expiraEm               DateTime
  emailAtualConfirmadoEm DateTime?
  concluidaEm            DateTime?
  invalidadaEm           DateTime?
  criadoEm               DateTime  @default(now())

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@index([emailNovo])
  @@index([expiraEm])
}

model TokenRecuperacaoSenha {
  id        String   @id @default(uuid()) @db.Uuid
  idUsuario String   @db.Uuid
  tokenHash String   @unique
  expiraEm  DateTime
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
}

model CodigoVerificacaoEmail {
  id         String   @id @default(uuid()) @db.Uuid
  idUsuario  String   @db.Uuid
  codigoHash String
  tentativas Int      @default(0)
  expiraEm   DateTime
  usado      Boolean  @default(false)
  criadoEm   DateTime @default(now())

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
}

model Sessao {
  id             String       @id @default(uuid()) @db.Uuid
  idUsuario      String       @db.Uuid
  tokenHash      String       @unique
  status         StatusSessao @default(ATIVA)
  substituidaPor String?      @db.Uuid
  expiraEm       DateTime
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
}

model Colecao {
  idColecao String  @id @default(uuid()) @db.Uuid
  idUsuario String  @db.Uuid
  nome      String
  descricao String?

  usuario Usuario @relation(fields: [idUsuario], references: [id])

  ambientesSonoros ColecaoAmbienteSonoro[]
}

model AmbienteSonoro {
  idAmbienteSonoro     String     @id @default(uuid()) @db.Uuid
  idUsuario            String     @db.Uuid
  idCategoria          String?    @db.Uuid
  nome                 String
  descricao            String?
  finalidade           Finalidade
  origem               String
  imagem               String?
  imagemPublicId       String?
  autorImagem          String?
  tituloOriginalImagem String?
  fonteImagem          String?
  licencaImagem        String?
  dataCriacao          DateTime   @default(now())
  publicado            Boolean    @default(false)

  usuario   Usuario    @relation(fields: [idUsuario], references: [id])
  categoria Categoria? @relation(fields: [idCategoria], references: [idCategoria], onDelete: Restrict)

  colecoes ColecaoAmbienteSonoro[]
  audios   AmbienteSonoroAudio[]

  @@index([origem, publicado])
  @@index([finalidade, publicado])
  @@index([idCategoria])
}

model Audio {
  idAudio         String   @id @default(uuid()) @db.Uuid
  idUsuario       String   @db.Uuid
  idCategoria     String   @db.Uuid
  descricao       String?
  icone           String?
  arquivo         String
  arquivoPublicId String?
  titulo          String
  tituloOriginal  String
  fonte           String
  licenca         String

  usuario   Usuario   @relation(fields: [idUsuario], references: [id])
  categoria Categoria @relation(fields: [idCategoria], references: [idCategoria])

  ambientesSonoros AmbienteSonoroAudio[]

  @@index([idCategoria])
}

model ColecaoAmbienteSonoro {
  idColecao        String @db.Uuid
  idAmbienteSonoro String @db.Uuid

  colecao        Colecao        @relation(fields: [idColecao], references: [idColecao])
  ambienteSonoro AmbienteSonoro @relation(fields: [idAmbienteSonoro], references: [idAmbienteSonoro])

  @@id([idColecao, idAmbienteSonoro])
}

model AmbienteSonoroAudio {
  idAmbienteSonoro String @db.Uuid
  idAudio          String @db.Uuid
  volume           Int

  ambienteSonoro AmbienteSonoro @relation(fields: [idAmbienteSonoro], references: [idAmbienteSonoro])
  audio          Audio          @relation(fields: [idAudio], references: [idAudio])

  @@id([idAmbienteSonoro, idAudio])
}
